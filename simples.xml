<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE language SYSTEM "language.dtd">

<language name="simples"
          version="1"
          kateversion="5.0"
          section="Other"
          extensions="*.simples">

  <highlighting>
    <list name="keywords">
      <item>programa</item>
      <item>fimprograma</item>
      <item>inicio</item>
      <item>inteiro</item>
      <item>logico</item>
      <item>se</item>
      <item>entao</item>
      <item>senao</item>
      <item>fimse</item>
      <item>enquanto</item>
      <item>faca</item>
      <item>fimenquanto</item>
      <item>leia</item>
      <item>escreva</item>
      <item>verdadeiro</item>
      <item>falso</item>
      <item>e</item>
      <item>ou</item>
      <item>nao</item>
      <item>div</item>
      <item>proc</item>
      <item>fimproc</item>
      <item>func</item>
      <item>fimfunc</item>
    </list>
    <list name="logicalOperators">
      <item>E</item>
      <item>OU</item>
      <item>NAO</item>
    </list>

    <contexts>
      <context name="Normal" attribute="Normal Text" lineEndContext="#stay">

      <!-- Comentários -->
      <Detect2Chars char="/" char1="/" attribute="Comment" context="LineComment"/>
      <DetectChar char="#" attribute="Comment" context="LineComment"/>

      <!-- Strings -->
      <RegExpr String="&quot;([^&quot;\\]|\\.)*&quot;|&apos;([^&apos;\\]|\\.)*&apos;"
           attribute="String" context="#stay"/>

      <!-- Rótulos -->
      <RegExpr String="^[ \t]*[A-Za-z_][A-Za-z0-9_]*(?=[ \t]*:)"
           attribute="Label" context="#stay"/>

      <!-- Palavras reservadas -->
      <keyword String="keywords" attribute="Keyword" context="#stay"/>

      <!-- Operadores lógicos -->
      <keyword String="logicalOperators" attribute="Operator" context="#stay"/>

      <!-- Números -->
      <RegExpr String="\b[0-9]+(\.[0-9]+)?\b"
           attribute="Number" context="#stay"/>

      <!-- Operadores relacionais e aritméticos -->
      <RegExpr String="&gt;|&lt;|=|[+\-*/]"
           attribute="Operator" context="#stay"/>

      <!-- Identificadores -->
      <RegExpr String="[A-Za-z_][A-Za-z0-9_]*"
           attribute="Identifier" context="#stay"/>

     </context>
    </contexts>
    <itemDatas>
      <!-- Texto e identificadores -->
      <itemData name="Normal Text"
            defStyleNum="dsNormal"
            color="#000000"/>

      <itemData name="Identifier"
            defStyleNum="dsNormal"
            color="#000000"/>

      <!-- Palavras reservadas -->
      <itemData name="Keyword"
            defStyleNum="dsKeyword"
            color="#0000CC"
            bold="1"/>

      <!-- Rótulos -->
      <itemData name="Label"
            defStyleNum="dsFunction"
            color="#800080"
            bold="1"/>

      <!-- Constantes numéricas -->
      <itemData name="Number"
            defStyleNum="dsDecVal"
            color="#008000"/>

      <!-- Operadores -->
      <itemData name="Operator"
            defStyleNum="dsNormal"
            color="#CC5500"
            bold="1"/>

      <!-- Cadeias de caracteres -->
      <itemData name="String"
            defStyleNum="dsString"
            color="#A31515"/>

      <!-- Comentários -->
      <itemData name="Comment"
            defStyleNum="dsComment"
            color="#808080"
            italic="1"/>
    </itemDatas>
  </highlighting>
</language>
