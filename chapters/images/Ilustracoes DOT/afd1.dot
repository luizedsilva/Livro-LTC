digraph automato_finito_deterministico {
	rankdir=LR;
	size="8,5"
	node [shape = point, color=white, fontcolor=white]; start;
	node [shape = doublecircle, color=black, fontcolor=black]; q1;
	node [shape = circle]; q0;
	start -> q0 [ label = "" ];
	q0 -> q0 [ label = "0" ];
	q0 -> q1 [ label = "1" ];
	q1 -> q0 [ label = "0" ];
	q1 -> q1 [ label = "1" ];
}