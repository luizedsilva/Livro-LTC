digraph AF {
    rankdir=LR;
    graph [fontname="Arial", nodesep=0.55, ranksep=0.75];
    node [shape=circle, fontname="Arial", fontsize=12];
    edge [fontname="Arial", fontsize=11, arrowsize=0.8];

    inicio [shape=point, width=0.08, label=""];

    // Estados
    0  [label="0"];
    X  [label="X"];
    1  [label="1"];
    2  [label="2", style="filled", fillcolor="lightgray"];
    3  [label="3"];
    7  [label="7"];
    55 [label="55"];

    outros3  [shape=plaintext, label="(...)"];
    outros7  [shape=plaintext, label="(...)"];
    outros55 [shape=plaintext, label="(...)"];
    reticencias [shape=plaintext, label="(...)"];

    // Início
    inicio -> 0 [label="início"];

    // Comentário /* ... */
    0 -> X [label="/*", tailport=n, headport=sw];
    X -> X [label="Qualquer símbolo", loopdir=right];
    X -> 0 [label="*/", tailport=e, headport=n];

    // Identificadores
    0 -> 1 [label="letra"];
    1 -> 1 [label="letra/dígito", loopdir=right];
    1 -> 2 [label="outro"];

    // Demais tokens (representação esquemática da figura)
    0 -> 3;
    3 -> outros3;

    0 -> 7;
    7 -> outros7;

    0 -> reticencias [style=invis];

    0 -> 55;
    55 -> outros55;

    // Organização visual
    {rank=same; 3; 7; reticencias; 55}
}
