digraph automato_afd {
   rankdir=LR;
   inicio [shape = none; label = ""];
   node [shape = doublecircle]; q1, q2;
   node [shape = circle];
   q0 [label="q0'[0,2,4,6,10,7,8]"]
   q1 [label="q1'[5,7,10,1,8,6,11]"]
   q2 [label="q2'[9,3,1]"]
   q3 [label="q3'[11,7,8,6,10]"]
   inicio->q0;
   q0 -> q1 [ label = "0" ]
   q0 -> q2 [ label = "1" ] 
   q1 -> q2 [ label = "1" ];
   q1 -> q3 [ label = "0" ];
   q3 -> q2 [ label = "1" ];
   q3 -> q3 [ label = "0" ];
}