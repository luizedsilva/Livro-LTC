digraph PDA {
    rankdir=LR;

    graph [
        bgcolor="transparent",
        splines=true,
        nodesep=0.8,
        ranksep=1.0
    ];

    node [
        shape=circle,
        style="filled",
        fillcolor="white",
        color="black",
        penwidth=1.5,
        fontname="Arial",
        fontsize=12,
        width=0.65,
        fixedsize=true
    ];

    edge [
        color="black",
        penwidth=1.2,
        arrowsize=0.8,
        fontname="Arial",
        fontsize=11
    ];

    // Estados
    q1 [label="q1", peripheries=1];
    q2 [label="q2"];
    q3 [label="q3"];
    q4 [label="q4", peripheries=2];
    q5 [label="q5"];
    q6 [label="q6"];
    q7 [label="q7", peripheries=2];

    // Estado inicial
    inicio [shape=point, width=0.10, label=""];
    inicio -> q1;

    // Transições
    q1 -> q2 [
        label="ε, ε, $"
    ];

    q2 -> q2 [
        label="a, ε, a",
        loopangle=90
    ];

    // Duas transições entre q2 e estados diferentes
    q2 -> q3 [
        label="ε, ε, ε",
        minlen=2
    ];

    q2 -> q5 [
        label="ε, ε, ε",
        minlen=2
    ];

    q3 -> q3 [
        label="b, a, ε",
        loopangle=120
    ];

    q3 -> q4 [
        label="ε, $, ε"
    ];

    q4 -> q4 [
        label="c, ε, ε",
        loopangle=45
    ];

    q5 -> q5 [
        label="b, ε, ε",
        loopangle=90
    ];

    q5 -> q6 [
        label="ε, ε, ε"
    ];

    q6 -> q6 [
        label="c, a, ε",
        loopangle=90
    ];

    q6 -> q7 [
        label="ε, $, ε"
    ];
}
