digraph AP {
    rankdir=LR;

    graph [
        bgcolor="transparent",
        splines=true,
        nodesep=0.8,
        ranksep=1.0
    ];

    node [
        shape=circle,
        style="filled",
        fillcolor="white",
        color="black",
        penwidth=1.5,
        fontname="Arial",
        fontsize=12,
        width=0.65,
        fixedsize=true
    ];

    edge [
        fontname="Arial",
        fontsize=12,
        color="black",
        penwidth=1.2,
        arrowsize=0.8
    ];

    // Estados
    q1 [label="q1", shape=circle, peripheries=2];
    q2 [label="q2"];
    q3 [label="q3"];
    q4 [label="q4", peripheries=2];

    // Estado inicial
    inicio [shape=point, width=0.1, label=""];

    // Transições
    inicio -> q1;

    q1 -> q2 [
        label="ε, ε → $"
    ];

    q2 -> q2 [
        label="0, ε → 0",
        loopangle=90
    ];

    q2 -> q3 [
        label="1, 0 → ε"
    ];

    q3 -> q3 [
        label="1, 0 → ε",
        loopangle=0
    ];

    q3 -> q4 [
        label="ε, $ → ε"
    ];
}
