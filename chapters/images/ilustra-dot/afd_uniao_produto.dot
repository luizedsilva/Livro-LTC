digraph AFD_Uniao {
    rankdir=LR;
    node [shape=circle, fontsize=13];
    edge [fontsize=12];
    inicio [shape=point, label=""];

    s00 [label="(q0,p0)"];
    s10 [shape=doublecircle, label="(q1,p0)"];
    s01 [shape=doublecircle, label="(q0,p1)"];
    s11 [shape=doublecircle, label="(q1,p1)"];

    inicio -> s00;

    s00 -> s10 [label="a"];
    s00 -> s01 [label="b"];

    s10 -> s10 [label="a"];
    s10 -> s01 [label="b"];

    s01 -> s10 [label="a"];
    s01 -> s01 [label="b"];

    s11 -> s10 [label="a"];
    s11 -> s01 [label="b"];
}
