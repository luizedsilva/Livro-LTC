    {
      "id": "jPIM6fguGmJCx8GfFDimn",
      "type": "text",
      "x": 380,
      "y": 625,
      "width": 210.35980224609375,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKs",
      "roundness": null,
      "seed": 1080067371,
      "version": 19,
      "versionNonce": 1041972402,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1794517048603,
      "created": 1794423112677,
      "link": null,
      "locked": false,
      "text": "programa rotina\n  inteiro x y\n  \n  proc p(ref inteiro s)\n    inteiro z\n  inicio\n    se s > 1\n       entao y <- 1\n       senao z <- s - 1\n             p(z)\n             y <- y * s\n    fimse\n  fimproc\n\ninicio\n   x <- 4\n   p(x)\n   escreva x\n   escreva y\nfimprograma",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "programa rotina\n  inteiro x y\n  \n  proc p(ref inteiro s)\n    inteiro z\n  inicio\n    se s > 1\n       entao y <- 1\n       senao z <- s - 1\n             p(z)\n             y <- y * s\n    fimse\n  fimproc\n\ninicio\n   x <- 4\n   p(x)\n   escreva x\n   escreva y\nfimprograma",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
